#!/bin/sh
# Inventory agent installer for Linux and macOS.
# Generated by {{.ServerURL}} - contains an enrollment token, do not share.
#
# Usage: curl -fsSL '<this url>' | sudo sh
set -eu

SERVER_URL='{{.ServerURL}}'
TOKEN='{{.Token}}'
BASE="${SERVER_URL}{{.APIPrefix}}/install/${TOKEN}"

say() { printf '%s\n' "inventory: $*"; }
die() { printf '%s\n' "inventory: ERROR: $*" >&2; exit 1; }

[ "$(id -u)" = "0" ] || die "please run as root (curl ... | sudo sh)"

OS=$(uname -s)
case "$OS" in
  Linux)  GOOS=linux ;;
  Darwin) GOOS=darwin ;;
  *) die "unsupported operating system: $OS" ;;
esac

case "$(uname -m)" in
  x86_64|amd64)          GOARCH=amd64 ;;
  aarch64|arm64)         GOARCH=arm64 ;;
  armv7l|armv7*|armv6l)  GOARCH=arm ;;
  *) die "unsupported architecture: $(uname -m)" ;;
esac

# System proxy: sudo usually drops the caller's proxy variables, so fall back
# to /etc/environment (Linux) or the network settings (macOS) like the agent.
if [ -z "${https_proxy:-}${HTTPS_PROXY:-}" ]; then
  if [ "$GOOS" = "linux" ] && [ -r /etc/environment ]; then
    for v in https_proxy HTTPS_PROXY http_proxy HTTP_PROXY no_proxy NO_PROXY; do
      val=$(sed -n "s/^[[:space:]]*\(export[[:space:]]\+\)\?$v=[\"']\?\([^\"']*\)[\"']\?[[:space:]]*$/\2/p" /etc/environment | tail -n 1)
      [ -n "$val" ] && export "$v=$val"
    done
  elif [ "$GOOS" = "darwin" ] && command -v scutil >/dev/null 2>&1; then
    P=$(scutil --proxy)
    if printf '%s\n' "$P" | grep -q 'HTTPSEnable : 1'; then
      host=$(printf '%s\n' "$P" | sed -n 's/^ *HTTPSProxy : //p')
      port=$(printf '%s\n' "$P" | sed -n 's/^ *HTTPSPort : //p')
      [ -n "$host" ] && export https_proxy="http://$host${port:+:$port}"
    fi
  fi
  P="${https_proxy:-${HTTPS_PROXY:-}}"
  [ -z "$P" ] || say "using proxy ${P##*@}"
fi

if [ "$GOOS" = "linux" ]; then
  [ -d /run/systemd/system ] || die "systemd is required"
  if ! command -v smartctl >/dev/null 2>&1; then
    say "installing smartmontools (for disk health) ..."
    if command -v apt-get >/dev/null 2>&1; then
      DEBIAN_FRONTEND=noninteractive apt-get install -y -q --no-install-recommends smartmontools >/dev/null || say "could not install smartmontools"
    elif command -v dnf >/dev/null 2>&1; then
      dnf install -y -q smartmontools >/dev/null || say "could not install smartmontools"
    elif command -v yum >/dev/null 2>&1; then
      yum install -y -q smartmontools >/dev/null || say "could not install smartmontools"
    elif command -v zypper >/dev/null 2>&1; then
      zypper --non-interactive --quiet install smartmontools >/dev/null || say "could not install smartmontools"
    elif command -v pacman >/dev/null 2>&1; then
      pacman -S --noconfirm --needed smartmontools >/dev/null || say "could not install smartmontools"
    else
      say "please install smartmontools manually to get disk health data"
    fi
  fi
else
  command -v smartctl >/dev/null 2>&1 || say "tip: 'brew install smartmontools' enables disk health data"
fi

TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT
say "downloading agent ($GOOS/$GOARCH) ..."
if command -v curl >/dev/null 2>&1; then
  curl -fsSL -o "$TMP/inventory-agent" "$BASE/agent/$GOOS/$GOARCH" || die "download failed"
elif command -v wget >/dev/null 2>&1; then
  wget -q -O "$TMP/inventory-agent" "$BASE/agent/$GOOS/$GOARCH" || die "download failed"
else
  die "curl or wget is required"
fi
chmod 0755 "$TMP/inventory-agent"

"$TMP/inventory-agent" install --server "$SERVER_URL" --token "$TOKEN"
